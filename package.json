{
  "name": "tagdafun",
  "version": "1.3.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "start:go": "EXPO_GO=1 expo start --go --lan --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "ts:check": "tsc --noEmit",
    "build:android": "eas build --platform android --profile production",
    "build:android-preview": "eas build --platform android --profile preview",
    "build:android-dev": "eas build --platform android --profile development",
    "build:ios": "eas build --platform ios --profile production",
    "submit:android": "eas submit --platform android",
    "submit:ios": "eas submit --platform ios",
    "build:script": "powershell -ExecutionPolicy Bypass -File build-android.ps1",
    "deploy:android": "npm run build:android && npm run submit:android",
    "deploy": "eas build --platform android --profile production"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^6.5.16",
    "@react-navigation/native": "^6.1.16",
    "@shopify/react-native-skia": "2.14.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.0",
    "expo": "58.0.19",
    "expo-audio": "~58.0.10",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.15",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-linear-gradient": "~58.0.3",
    "expo-sharing": "~58.0.20",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-view-shot": "6.1.1",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "typescript": "~6.0.3",
    "unity-levelplay-mediation": "^9.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@expo/ngrok": "^4.1.3",
    "babel-plugin-module-resolver": "^5.0.0"
  },
  "private": true
}
